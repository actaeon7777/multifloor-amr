# Copy to config/server.env; contains paths/settings, never token contents.
AMR_PORT=8081
AMR_ROBOT_ID=amr-01
AMR_TOKEN_FILE="$HOME/.config/amr_remote_bridge/token"
AMR_STALE_AFTER=2
AMR_COMMAND_TIMEOUT=3
AMR_LEASE_TIMEOUT=3
AMR_MAX_ROBOTS=32
AMR_BODY_TIMEOUT=10

AMR_SLACK_ENV="$HOME/.config/amr_remote_bridge/slack.env"
AMR_SLACK_ROOMS="$HOME/.config/amr_remote_bridge/slack_rooms.json"

# Default data directory: Control_Server/data (override with --data-dir or AMR_DATA_DIR).
# AMR_DATA_DIR="/srv/amr/events"
AMR_MAX_EVENTS=5000
AMR_MAX_IMAGE_BYTES=1073741824
