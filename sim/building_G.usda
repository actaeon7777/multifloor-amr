#usda 1.0
(
    defaultPrim = "World"
    doc = "Generated by sim/tools/build_building_scene.py from src/amr_system/amr_stack/config/floors.yaml; do not edit."
    metersPerUnit = 1
    subLayers = [
        @./amr_flat_test.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    over "Ground" (
        active = false
    )
    {
    }

    over "Sun" (
        active = false
    )
    {
    }

    over "Fill" (
        active = false
    )
    {
    }

    def Scope "Looks"
    {
        def Material "CeilingMaterial"
        {
            token outputs:surface.connect = <Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.86, 0.84)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "LightPanelMaterial"
        {
            token outputs:surface.connect = <Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1.0, 1.0, 1.0)
                    color3f inputs:emissiveColor = (4.0, 3.8, 3.52)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

    }

    over "AMR"
    {
        double3 xformOp:translate = (11.5, 3.31, 0.002)
    }

