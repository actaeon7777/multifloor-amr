#usda 1.0
(
    defaultPrim = "World"
    doc = "G building fourth-floor map with the workspace's current v28 AMR."
    metersPerUnit = 1
    subLayers = [
        @./layers/4_floor_0522_map.usda@,
        @./amr_flat_test.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    over "Ground" (
        active = false
    )
    {
    }

    over "AMR"
    {
        # Clear lobby in front of the elevator; retain the flat scene's 2 mm
        # initial contact clearance and current robot physics.
        double3 xformOp:translate = (11.5, 3.31, 0.002)
    }

    def Camera "Floor4Camera"
    {
        float2 clippingRange = (0.01, 100)
        float focalLength = 24
        double3 xformOp:translate = (15.5, -2.69, 6)
        float3 xformOp:rotateXYZ = (52, 0, 34)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
