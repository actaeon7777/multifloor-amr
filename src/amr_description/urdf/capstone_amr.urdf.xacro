<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="capstone_amr">

  <!--
    Isaac Sim source description.
    Coordinate convention: +X forward, +Y left, +Z up.
    base_link is the midpoint of the left/right drive-wheel axle.
    Mesh files use millimetres; mesh scale converts millimetres to metres.
    Geometry revision: AMR_MASTER_Linear v80.step (2026-10-16): aluminium
    profile frame with upper structure, Z10T mast, linear-guide drive-wheel
    suspension (modelled rigid) and 529 mm drive track. The base_link inertia
    box approximation from v28 is retained.
    v119 (2026-10-20) adds the four-piece housing, an Orbbec Gemini 2 depth
    camera in the housing nose (pitched 12 deg up) and the rear XT90 connector.

    Direct Isaac Sim import uses the expanded capstone_amr.urdf beside this file.
    Import as Robot Type=Wheeled, Base Type=Mobile, with self-collision disabled.
  -->

  <xacro:arg name="mesh_prefix" default="../meshes/visual"/>
  <xacro:property name="mesh_prefix" value="$(arg mesh_prefix)"/>

  <xacro:property name="wheel_radius" value="0.086"/>
  <xacro:property name="wheel_width" value="0.0446"/>
  <xacro:property name="wheel_track" value="0.529"/>
  <xacro:property name="drive_axle_x" value="0.0"/>
  <xacro:property name="drive_wheel_mesh_scale" value="0.001004086"/>
  <xacro:property name="drive_wheel_mesh_y" value="0.029118494"/>

  <!-- v28 base_link inertia box, retained until the robot is reweighed. -->
  <xacro:property name="base_inertia_length" value="0.640"/>
  <xacro:property name="base_inertia_width" value="0.520"/>
  <xacro:property name="base_inertia_height" value="0.085"/>
  <xacro:property name="base_inertia_center_z" value="-0.0115"/>

  <!--
    v119 housing outer bounds: X +-328, Y +-278, Z -55 to 80 mm, with fenders
    over the drive wheels (X +-114, |Y| 180 to 278 mm) up to Z 100 mm. It
    encloses the lower profile frame (X +-320, Y +-260, Z -54 to 1 mm).
  -->
  <xacro:property name="housing_length" value="0.656"/>
  <xacro:property name="housing_width" value="0.556"/>
  <xacro:property name="housing_bottom_z" value="-0.055"/>
  <xacro:property name="housing_top_z" value="0.080"/>

  <!--
    Gemini 2 in the v119 STEP: body origin at base_link (311, 0, 59) mm, optical
    axes pitched 12 deg up. camera_link is the left (+Y) IR lens front on its
    optical axis, where the Orbbec driver's depth frame is assumed to sit.
  -->
  <xacro:property name="camera_x" value="0.320488"/>
  <xacro:property name="camera_y" value="0.025"/>
  <xacro:property name="camera_z" value="0.061017"/>
  <xacro:property name="camera_pitch" value="${-12.0 * pi / 180.0}"/>

  <!--
    18.0 kg total mass (set 2026-10-20 for v119; v28 measured 15.0 kg):
      base_link remainder 12.8 kg (battery, frame, upper frame, mast, Z10T,
        housing, electronics, LiDAR, Gemini 2 and their mounts)
      two drive wheels 2 x 2.2 kg, four complete casters 4 x 0.2 kg (measured).
    Each caster's measured 0.2 kg is provisionally split across its three links.
    The 3.0 kg increase is all on base_link, inside the v28 inertia box below.
  -->
  <xacro:property name="chassis_mass" value="12.8"/>
  <xacro:property name="drive_wheel_mass" value="2.2"/>
  <xacro:property name="caster_mount_mass" value="0.05"/>
  <xacro:property name="caster_frame_mass" value="0.10"/>
  <xacro:property name="caster_wheel_mass" value="0.05"/>

  <!-- Placement rechecked against AMR_MASTER_Linear v80.step; unchanged from v23. -->
  <xacro:property name="lidar_mount_origin_z" value="-0.029"/>
  <xacro:property name="lidar_from_mount_z" value="0.137605"/>

  <material name="aluminium">
    <color rgba="0.55 0.60 0.66 1"/>
  </material>
  <material name="dark_metal">
    <color rgba="0.28 0.33 0.39 1"/>
  </material>
  <material name="z10t_body">
    <color rgba="0.12 0.13 0.15 1"/>
  </material>
  <material name="housing">
    <color rgba="0.82 0.83 0.84 1"/>
  </material>
  <material name="rubber">
    <color rgba="0.04 0.045 0.055 1"/>
  </material>

  <xacro:macro name="box_inertial" params="mass x y z origin_xyz">
    <inertial>
      <origin xyz="${origin_xyz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel_inertial" params="mass radius width">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3*radius*radius + width*width) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * radius*radius / 2.0}" iyz="0"
        izz="${mass * (3*radius*radius + width*width) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="frame_box" params="x y z sx sy sz">
    <collision>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
    </collision>
  </xacro:macro>

  <link name="base_footprint"/>

  <link name="base_link">
    <xacro:box_inertial
      mass="${chassis_mass}"
      x="${base_inertia_length}" y="${base_inertia_width}" z="${base_inertia_height}"
      origin_xyz="0 0 ${base_inertia_center_z}"/>
    <!-- These four STLs are already expressed in the base_link CAD frame.
         chassis.stl also carries the rear XT90 connector. -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/chassis.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <!-- Linear-guide suspension brackets of both drive wheels; rigid in this model. -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/drive_suspension.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_metal"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/z10t.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="z10t_body"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/housing.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="housing"/>
    </visual>
    <!-- Camera geometry is lumped into base_link like the LiDAR;
         gemini2.stl is expressed in the camera_link frame. -->
    <visual>
      <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 ${camera_pitch} 0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/gemini2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="z10t_body"/>
    </visual>
    <!-- LiDAR geometry is lumped into base_link together with its mass. -->
    <visual>
      <origin xyz="0 0 ${lidar_mount_origin_z}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/lidar_mount.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="0 0 ${lidar_mount_origin_z + lidar_from_mount_z}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/lidar_body.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_metal"/>
    </visual>
    <!-- PhysX-friendly collision boxes from the v119 part bounds. The housing
         box also covers the lower frame, the suspension brackets, the camera
         (front at X 324 mm) and the XT90 connector (rear at X -326 mm). -->
    <collision>
      <origin xyz="0 0 ${(housing_bottom_z + housing_top_z) / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${housing_length} ${housing_width} ${housing_top_z - housing_bottom_z}"/>
      </geometry>
    </collision>
    <!-- Fenders over the drive wheels. -->
    <xacro:frame_box x="0" y="0.229" z="0.090" sx="0.228" sy="0.098" sz="0.020"/>
    <xacro:frame_box x="0" y="-0.229" z="0.090" sx="0.228" sy="0.098" sz="0.020"/>
    <!-- 2020 uprights. They cross the LiDAR scan plane at Z = 108.605 mm. -->
    <xacro:frame_box x="0.270" y="0.1326" z="0.066" sx="0.020" sy="0.040" sz="0.200"/>
    <xacro:frame_box x="0.270" y="-0.1326" z="0.066" sx="0.020" sy="0.040" sz="0.200"/>
    <xacro:frame_box x="-0.260" y="0.1326" z="0.066" sx="0.020" sy="0.040" sz="0.200"/>
    <xacro:frame_box x="-0.260" y="-0.1326" z="0.066" sx="0.020" sy="0.040" sz="0.200"/>
    <!-- Top side rails, front cross member and Z10T mast. -->
    <xacro:frame_box x="0.005" y="0.1326" z="0.156" sx="0.510" sy="0.040" sz="0.020"/>
    <xacro:frame_box x="0.005" y="-0.1326" z="0.156" sx="0.510" sy="0.040" sz="0.020"/>
    <xacro:frame_box x="0.240" y="0" z="0.176" sx="0.040" sy="0.3107" sz="0.020"/>
    <xacro:frame_box x="0.250" y="0" z="0.421" sx="0.020" sy="0.040" sz="0.470"/>
    <!-- Z10T mount below the body, then the Z10T body bounds. -->
    <xacro:frame_box x="0.2372" y="0" z="0.6035" sx="0.0764" sy="0.100" sz="0.055"/>
    <xacro:frame_box x="0.2308" y="0" z="0.6925" sx="0.123" sy="0.233" sz="0.123"/>
    <!-- v3 mount: two extended walls, two upper side walls, and top plate.
         Small counterbored screw holes are omitted from collision geometry. -->
    <collision>
      <origin xyz="0 -0.035 ${lidar_mount_origin_z + 0.0475}" rpy="0 0 0"/>
      <geometry><box size="0.080 0.010 0.105"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0.035 ${lidar_mount_origin_z + 0.0475}" rpy="0 0 0"/>
      <geometry><box size="0.080 0.010 0.105"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.035 0 ${lidar_mount_origin_z + 0.075}" rpy="0 0 0"/>
      <geometry><box size="0.010 0.060 0.050"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.035 0 ${lidar_mount_origin_z + 0.075}" rpy="0 0 0"/>
      <geometry><box size="0.010 0.060 0.050"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 ${lidar_mount_origin_z + 0.105}" rpy="0 0 0"/>
      <geometry><box size="0.080 0.080 0.010"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 ${lidar_mount_origin_z + lidar_from_mount_z - 0.008345}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0385" length="0.038884"/></geometry>
    </collision>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="drive_wheel" params="side y mesh_y mesh_roll">
    <link name="${side}_drive_wheel_link">
      <xacro:wheel_inertial mass="${drive_wheel_mass}" radius="${wheel_radius}" width="${wheel_width}"/>
      <visual>
        <origin xyz="0 ${mesh_y} 0" rpy="${mesh_roll} 0 0"/>
        <geometry>
          <mesh filename="${mesh_prefix}/nurirobot_wa171_3d_v5.stl"
                scale="${drive_wheel_mesh_scale} ${drive_wheel_mesh_scale} ${drive_wheel_mesh_scale}"/>
        </geometry>
        <material name="rubber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${side}_drive_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_drive_wheel_link"/>
      <origin xyz="${drive_axle_x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>
  </xacro:macro>

  <!-- Configure only these joints as Velocity Drive in Isaac Sim. -->
  <xacro:drive_wheel side="left" y="${wheel_track / 2.0}" mesh_y="${-drive_wheel_mesh_y}" mesh_roll="0"/>
  <xacro:drive_wheel side="right" y="${-wheel_track / 2.0}" mesh_y="${drive_wheel_mesh_y}" mesh_roll="3.14159265359"/>

  <xacro:macro name="passive_caster" params="prefix x y">
    <link name="${prefix}_caster_mount_link">
      <xacro:box_inertial mass="${caster_mount_mass}"
        x="0.064" y="0.046" z="0.0069" origin_xyz="0 0 -0.00095"/>
      <visual>
        <origin xyz="0 0 0.0025" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/caster_mount_fixed.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="aluminium"/>
      </visual>
      <collision>
        <origin xyz="0 0 -0.00095" rpy="0 0 0"/>
        <geometry><box size="0.064 0.046 0.0069"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}_caster_mount_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster_mount_link"/>
      <origin xyz="${x} ${y} -0.0215" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}_caster_swivel_link">
      <xacro:box_inertial mass="${caster_frame_mass}"
        x="0.048031" y="0.032" z="0.042576" origin_xyz="0.003485 0 -0.025688"/>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/caster_swivel_frame.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="dark_metal"/>
      </visual>
    </link>
    <joint name="${prefix}_caster_swivel_joint" type="continuous">
      <parent link="${prefix}_caster_mount_link"/>
      <child link="${prefix}_caster_swivel_link"/>
      <origin xyz="0 0 0" rpy="0 0 3.14159265359"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.08" friction="0.02"/>
    </joint>

    <link name="${prefix}_caster_wheel_link">
      <xacro:wheel_inertial mass="${caster_wheel_mass}" radius="0.0225" width="0.025"/>
      <visual>
        <origin xyz="-0.020 0 0.042" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_prefix}/caster_wheel.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="rubber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="0.0225" length="0.025"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}_caster_wheel_joint" type="continuous">
      <parent link="${prefix}_caster_swivel_link"/>
      <child link="${prefix}_caster_wheel_link"/>
      <origin xyz="0.020 0 -0.042" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.02" friction="0.01"/>
    </joint>
  </xacro:macro>

  <!-- Keep all caster swivel and wheel joints passive (Drive=None) in Isaac Sim. -->
  <xacro:passive_caster prefix="front_left" x="0.190" y="0.220"/>
  <xacro:passive_caster prefix="front_right" x="0.190" y="-0.220"/>
  <xacro:passive_caster prefix="rear_left" x="-0.190" y="0.220"/>
  <xacro:passive_caster prefix="rear_right" x="-0.190" y="-0.220"/>

  <!--
    Fixed LiDAR assembly. The lidar_link origin is the CAD sensor origin and
    scan centre: base_link xyz = 0 0 0.108605 m, rpy = 0 0 0.
    Visuals, collisions and physical mass are lumped into base_link. These
    empty fixed links preserve the mounting and scan coordinate frames for
    an Isaac Sim RTX LiDAR prim.
  -->
  <link name="lidar_mount_link"/>
  <joint name="lidar_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_mount_link"/>
    <origin xyz="0 0 ${lidar_mount_origin_z}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_mount_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_from_mount_z}" rpy="0 0 0"/>
  </joint>

  <!-- Real S2 scan axes: +X points backwards relative to the robot. -->
  <link name="laser"/>
  <joint name="laser_joint" type="fixed">
    <parent link="lidar_link"/>
    <child link="laser"/>
    <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
  </joint>

  <!-- LSM6DSV16X chip centre measured in CAD (v119 board position, 2026-10-23);
       axes match base_link. The EKF fuses only gyro Z, so this offset does
       not change the fused yaw rate. -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.097 0 0.021" rpy="0 0 0"/>
  </joint>

  <!--
    Orbbec Gemini 2 mount frame (+X along the optical axis, +Z up, pitched
    12 deg up). OrbbecSDK_ROS2 publishes camera_link -> depth/color/IR and
    optical frames itself from the factory calibration, so none of those
    frames are defined here. Depth FOV 91 x 66 deg, 50 mm baseline.
  -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 ${camera_pitch} 0"/>
  </joint>

</robot>
